# Normaliza los finales de linea para que el repositorio sea igual
# sin importar el sistema operativo de quien trabaje en el.
#
# Por defecto: texto detectado automaticamente, guardado con LF en el repositorio.
* text=auto eol=lf

# Archivos que Windows necesita con CRLF
*.sln       text eol=crlf
*.slnx      text eol=lf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Archivos que deben conservar LF siempre
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binarios: git no debe tocarlos
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary

# Certificados y llaves: binarios, y nunca deberian estar en el repositorio
*.pfx       binary
*.p12       binary
*.snk       binary

# Los esquemas de UBL 2.1 son la distribucion oficial de OASIS, sin
# modificar. Marcarlos como dependencia externa los excluye de las
# estadisticas de lenguaje de GitHub y de los diff por defecto: son 82.000
# lineas que nadie escribio aqui y que nadie va a revisar.
#
# Se versionan enteros en vez de recortados a los tres documentos que usamos
# para que su procedencia sea verificable: cualquiera puede comparar la
# carpeta con el paquete de OASIS y comprobar que no se toco nada.
schemas/** linguist-vendored
schemas/** linguist-generated=true
