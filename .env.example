# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube al repositorio (RNF-01).

# ─── Base de datos ───
POSTGRES_DB=fevcore
POSTGRES_USER=fevcore
POSTGRES_PASSWORD=cambiar_este_valor_en_cada_entorno

# ─── Firma digital (RF-17) ───
# El certificado va en base 64, NUNCA como archivo en el repositorio.
# Para convertir un .p12 o .pfx:
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("cert.p12"))
#   Linux/macOS: base64 -w0 cert.p12
#
# Sin estas dos variables el sistema arranca igual y falla al firmar con
# CERTIFICADO_NO_CONFIGURADO. Es deliberado: se puede levantar el proyecto
# y recorrerlo entero sin tener un certificado real.
Firma__CertificadoBase64=
Firma__Clave=

# ─── Ambiente de la DIAN ───
# Produccion o Pruebas. Entra en el calculo del codigo unico, asi que un
# documento de pruebas y uno de produccion con los mismos datos producen
# codigos distintos. Por defecto Pruebas.
Dian__Ambiente=Pruebas

# ─── Servicio de validacion (RF-18, RF-19) ───
# Dentro de docker compose ya apunta al simulador por su nombre de servicio,
# asi que esto solo hace falta si se ejecuta la API fuera de compose.
#   dotnet run --project src/FevCore.DianSimulator   ->  http://localhost:5108
Validacion__UrlBase=http://localhost:5108

# Cuanto se espera una respuesta antes de darla por perdida. Es la frontera
# entre "tardo mucho" y "no se sabe si llego" (ADR-0014): bajarlo produce
# documentos FALLIDOS por un servicio simplemente lento.
Validacion__TiempoEsperaSegundos=30

# ─── Bandeja de salida (RNF-04, RNF-05, ADR-0013) ───
# Apagar el trabajador deja los documentos en RECIBIDO indefinidamente.
# Solo tiene sentido para depurar.
Salida__Habilitado=true
Salida__IntervaloSondeoSegundos=2
Salida__MaximoIntentos=5

# Techo de la espera creciente. Sin el, el intento numero quince esperaria
# nueve horas.
Salida__EsperaMaximaSegundos=300

# Cuanto puede estar tomada una tarea antes de considerarla abandonada.
# Demasiado corto y dos trabajadores procesan la misma; demasiado largo y un
# reinicio deja documentos parados.
Salida__TiempoDeAbandonoSegundos=120

